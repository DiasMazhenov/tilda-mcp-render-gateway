PUBLIC_BASE_URL=https://your-service.onrender.com
OAUTH_SIGNING_SECRET=REPLACE_WITH_64_HEX_CHARACTERS
ADMIN_PASSWORD=REPLACE_WITH_RANDOM_10_PLUS_CHARACTER_PASSWORD
# Paste only in Render Environment. Never commit a real connection string.
DATABASE_URL=postgresql://ROLE:PASSWORD@YOUR_HOST.neon.tech/neondb?sslmode=require
# Local development alternative, leave DATABASE_URL unset:
# DATA_DIR=/absolute/path/to/private-data
